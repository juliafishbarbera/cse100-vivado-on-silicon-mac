#!/bin/zsh

set -u
project_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)
scripts_dir="$project_dir/scripts"
source "$scripts_dir/header.sh"

function usage {
    cat <<'EOF'
Vivado on Apple Silicon

Usage:
  ./vivado doctor
  ./vivado install [--rebuild-image] [installer.bin]
  ./vivado start [--usb]
  ./vivado clean
  ./vivado build-image [--rebuild]

USB forwarding is optional and currently supports FT2232C-based boards.
EOF
}

command_name="${1:-help}"
if (( $# > 0 )); then
    shift
fi

case "$command_name" in
    help|-h|--help)
        usage
        ;;
    doctor)
        validate_macos
        failed=0
        f_echo "Checking this Mac..."
        echo "Architecture: $(uname -m)"
        if [[ "$(uname -m)" == "arm64" ]]; then
            if arch -arch x86_64 /usr/bin/true > /dev/null 2>&1; then
                echo "Rosetta: ready"
            else
                echo "Rosetta: not installed"
                failed=1
            fi
        fi

        if ! command -v docker > /dev/null 2>&1; then
            echo "Docker: not installed"
            failed=1
        elif docker info > /dev/null 2>&1; then
            echo "Docker: ready"
        else
            echo "Docker: installed but not running"
            failed=1
        fi

        if docker image inspect "$container_image" > /dev/null 2>&1; then
            echo "Support image: ready"
        else
            echo "Support image: not built yet"
        fi

        missing_configs=0
        for code in "${supported_version_codes[@]}"; do
            if [[ ! -f "$scripts_dir/install_configs/${code}.txt" ]]; then
                echo "Missing installer configuration: ${version_labels[$code]}"
                missing_configs=1
            fi
        done
        if (( missing_configs )); then
            failed=1
        else
            echo "Version configurations: ready"
        fi

        if [[ -n "$(find "$project_dir/Xilinx/Vivado" -path '*/bin/vivado' -type f -print -quit 2>/dev/null)" ]]; then
            echo "Vivado installation: ready"
        else
            echo "Vivado installation: not installed yet"
        fi

        available_kb=$(df -Pk "$project_dir" | awk 'NR==2 {print $4}')
        available_gb=$(( available_kb / 1024 / 1024 ))
        echo "Free disk space: approximately ${available_gb} GiB"
        if (( available_gb < 50 )); then
            echo "Warning: at least 50 GiB free is recommended."
        fi

        if lsof -nP -iTCP:5901 -sTCP:LISTEN > /dev/null 2>&1; then
            echo "VNC port 5901: already in use"
            failed=1
        else
            echo "VNC port 5901: available"
        fi

        if (( failed )); then
            f_echo "Some checks need attention."
            exit 1
        fi
        f_echo "Preflight checks passed."
        ;;
    install)
        rebuild=0
        installer=""
        while (( $# > 0 )); do
            case "$1" in
                --rebuild-image) rebuild=1 ;;
                -h|--help) usage; exit 0 ;;
                --*) f_echo "Unknown option: $1"; exit 2 ;;
                *)
                    if [[ -n "$installer" ]]; then
                        f_echo "Only one installer path may be provided."
                        exit 2
                    fi
                    installer="$1"
                    ;;
            esac
            shift
        done
        VIVADO_REBUILD_IMAGE="$rebuild" "$scripts_dir/setup.sh" "$installer"
        ;;
    start)
        "$scripts_dir/start_container.sh" "$@"
        ;;
    clean)
        "$scripts_dir/cleanup.sh"
        ;;
    build-image)
        "$scripts_dir/gen_image.sh" "$@"
        ;;
    *)
        f_echo "Unknown command: $command_name"
        usage
        exit 2
        ;;
esac
